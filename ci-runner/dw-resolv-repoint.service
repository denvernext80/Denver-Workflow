[Unit]
Description=dw-ci: re-point /etc/resolv.conf at local serve-stale resolver (unbound)
Documentation=https://github.com/denvernext80/Denver-Workflow
# unbound 가 떠야 127.0.0.1 이 살아있으므로 그 뒤로 순서를 잡는다(파일 재작성엔 네트워크
# 불요 → network-online.target 은 걸지 않는다).
#
# 실측(2026-09-11, dw-ci): /etc/resolv.conf 심링크 mtime 은 2026-07-23 로, 2026-09-07 부팅을
#   넘어 «불변»이었다 — 즉 OrbStack 는 부팅마다 심링크를 재생성하지 «않는다»(게스트 유닛도 mount
#   전용, resolv.conf 를 쓰는 유닛 없음). OrbStack 파일 헤더도 「심링크 지우고 새 파일 만들라」고
#   안내한다 ⇒ 정규파일 교체는 부팅 넘어 지속될 가능성이 높다. 따라서 이 oneshot 은 「만일 재생성」
#   대비 belt-and-suspenders 다(브랜치 시점 실측상 필수는 아님).
# 🔴 확정 판별검사(배포 후 1회): `orbctl restart dw-ci` → `cat /etc/resolv.conf` 첫 줄이
#   127.0.0.1 이고 심링크가 아닌지 확인. 최악(만일 재생성)이라도 폴백 nameserver(0.250.250.200)로
#   «프록시 직결»(=R2 이전 동작) degrade 일 뿐 DNS 전면 중단은 아니다.
After=unbound.service
Wants=unbound.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 설치 경로는 wire-ci-runners 가 여기로 떨군다(payload: ci-runner/dw-resolv-repoint.sh).
ExecStart=/usr/local/sbin/dw-resolv-repoint

[Install]
WantedBy=multi-user.target
